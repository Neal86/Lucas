# Lucas Gateway
GWC_HOST=0.0.0.0
GWC_PORT=8787
GWC_DATA_DIR=./data
GWC_PUBLIC_BASE_URL=https://lucasmcp.com
GWC_JWT_TTL_SECONDS=2592000

# REQUIRED in production: explicit administrator identity.
GWC_SUPER_ADMIN_EMAIL=owner@example.com
# Optional explicit persistent JWT secret; otherwise Lucas persists one in GWC_DATA_DIR.
# GWC_JWT_SECRET=replace-with-a-long-random-secret

# Registration protection / email verification
# GWC_TURNSTILE_SITE_KEY=
# GWC_TURNSTILE_SECRET_KEY=
# GWC_SMTP_HOST=
# GWC_SMTP_PORT=587
# GWC_SMTP_USERNAME=
# GWC_SMTP_PASSWORD=
# GWC_SMTP_FROM=Lucas <no-reply@example.com>
# GWC_SMTP_STARTTLS=true

# Google sign-in
# GWC_GOOGLE_CLIENT_ID=
# GWC_GOOGLE_CLIENT_SECRET=
# GWC_GOOGLE_REDIRECT_URI=https://lucasmcp.com/auth/google/callback

# Stripe monthly prices
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PRO_PLUS=price_...
# STRIPE_PRICE_EXPANSION=price_...

# Stripe annual prices
# Pro: $99.99/year
# Pro+: $199.99/year
# Expansion Pack: $149.99/year
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_PLUS_ANNUAL=
STRIPE_PRICE_EXPANSION_ANNUAL=

# Meta Pixel / Conversions API
META_PIXEL_ID=1406185724930401
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Windows Node is configured locally by the Lucas Node app. Typical overrides:
# GWC_NODE_ID=
# GWC_NODE_NAME=
# GWC_GATEWAY_WS=wss://lucasmcp.com/ws/node
# GWC_NODE_TOKEN=
# GWC_ALLOWED_ROOTS=C:\Users\YourName;D:\Projects
