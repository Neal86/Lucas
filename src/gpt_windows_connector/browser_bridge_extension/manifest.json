{
  "manifest_version": 3,
  "name": "Lucas Browser",
  "version": "2.0.0",
  "description": "Let your AI work in existing browser tabs through Lucas. Background control, screenshots, page context and local website permissions.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "webNavigation",
    "debugger",
    "sidePanel",
    "contextMenus",
    "tabGroups",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "targets.js",
        "page_data.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Lucas Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "options_page": "options.html",
  "minimum_chrome_version": "120",
  "optional_permissions": [
    "history",
    "bookmarks"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-lucas": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Lucas browser sidebar"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
