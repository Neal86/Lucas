# Gateway
GWC_HOST=0.0.0.0
GWC_PORT=8787
GWC_DATA_DIR=./data
GWC_PUBLIC_BASE_URL=https://gwc.example.com

# Multi-user authentication
# If omitted, GWC_JWT_SECRET is generated once and persisted in GWC_DATA_DIR/jwt-secret.txt
# GWC_JWT_SECRET=replace-with-a-long-random-secret
GWC_JWT_TTL_SECONDS=2592000

# Google Sign-In (OAuth 2.0 / OpenID Connect)
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI must exactly match GWC_GOOGLE_REDIRECT_URI.
# GWC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GWC_GOOGLE_CLIENT_SECRET=xxxxxxxx
# GWC_GOOGLE_REDIRECT_URI=https://gwc.example.com/auth/google/callback
# Optional web UI destination after Google login. Token is returned in URL fragment.
# GWC_AUTH_SUCCESS_URL=https://app.example.com/login/callback

# Optional legacy/admin value retained for deployment compatibility.
# Normal MCP access now uses each user's JWT access token.
# GWC_ADMIN_TOKEN=replace-with-a-long-random-token

# Optional overrides. If omitted, safe Host/Origin allowlists are derived from
# GWC_PUBLIC_BASE_URL and localhost is also allowed for local health/debug use.
# GWC_ALLOWED_HOSTS=gwc.example.com,gwc.example.com:*,localhost:*,127.0.0.1:*
# GWC_ALLOWED_ORIGINS=https://gwc.example.com,https://gwc.example.com:*,http://localhost:*,http://127.0.0.1:*

# Windows node (set on Windows, not usually in the gateway container)
# GWC_NODE_ID=Office-PC
# GWC_NODE_NAME=Office PC
# GWC_GATEWAY_WS=wss://gwc.example.com/ws/node
# GWC_PAIRING_CODE=123456
# GWC_ALLOWED_ROOTS=G:\;D:\Projects
# GWC_PERMISSION_LEVEL=operate
